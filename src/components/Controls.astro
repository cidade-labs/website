---
import { localizePath, languages } from '../i18n/ui.js';
import { register } from '../i18n/register.js';
const { lang = 'gl' } = Astro.props;
const t = register[lang];

// Light and dark follow the reader's own system setting, so there is no control for it.
const bare = Astro.url.pathname.replace(/^\/(es|en)(?=\/|$)/, '') || '/';
---
<div class="register-controls"><nav aria-label={t.languages}>{languages.map(code => <a data-language href={localizePath(bare,code)} lang={code} aria-label={code+' — '+{gl:'Galego',es:'Español',en:'English'}[code]} aria-current={code===lang?'page':undefined}>{code}</a>)}</nav></div>
